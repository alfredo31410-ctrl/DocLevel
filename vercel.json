{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/landings",
      "destination": "https://doclevel-landings.vercel.app/landings"
    },
    {
      "source": "/landings/:path*",
      "destination": "https://doclevel-landings.vercel.app/landings/:path*"
    },
    {
      "source": "/medicos-docentes",
      "destination": "https://doclevel-landings.vercel.app/medicos-docentes"
    },
    {
      "source": "/medicos-docentes/:path*",
      "destination": "https://doclevel-landings.vercel.app/medicos-docentes/:path*"
    }
  ]
}
